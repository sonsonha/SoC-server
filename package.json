{
  "name": "personal-secretary-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/infrastructure/db/migrate.js",
    "seed": "tsx scripts/seed-from-bootstrap.ts",
    "seed:v2-goal-demo": "tsx scripts/seed-v2-goal-demo.ts",
    "seed:v2-goal-demo:reset": "tsx scripts/seed-v2-goal-demo.ts --reset",
    "planner:backfill-owner": "node dist/scripts/backfill-planner-owner.js",
    "planner:verify-ownership": "node dist/scripts/verify-planner-ownership.js",
    "planner:enforce-ownership-not-null": "node dist/scripts/enforce-planner-ownership-not-null.js",
    "calendar:backfill-owner": "node dist/scripts/backfill-calendar-owner.js",
    "calendar:enforce-ownership-not-null": "node dist/scripts/enforce-calendar-ownership-not-null.js",
    "calendar:verify-schema": "node dist/scripts/verify-calendar-schema.js",
    "ai:verify-schema": "node dist/scripts/verifyAiSchema.js",
    "ai:seed-owner-context": "node dist/scripts/seedOwnerAiContext.js",
    "ai:smoke-goal-structure": "node dist/scripts/smokeGoalStructure.js",
    "onboarding:backfill-owner": "node dist/scripts/backfill-onboarding-owner.js",
    "dev:data:reset": "tsx scripts/dev-data-reset.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.1",
    "jose": "^5.10.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.30.4",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}

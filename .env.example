DATABASE_URL=postgres://YOUR_USER@localhost:5432/secretary

# HTTP
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Device auth — long random string; never commit the real value
DEVICE_AUTH_PEPPER=change-me-to-a-long-random-pepper

# Optional: shared only by the backend and private web proxy (minimum 32 chars)
# PLANNER_WEB_TOKEN=

# Batch A — Google identity (openid/email/profile). Defaults to GOOGLE_OAUTH_CLIENT_ID.
# GOOGLE_IDENTITY_CLIENT_ID=
# PERSONAL_OS_ALLOWED_EMAILS=you@example.com
# Batch B — explicit owner for planner backfill + legacy Calendar (never auto-picked)
# PERSONAL_OS_INITIAL_OWNER_EMAIL=you@example.com
# Batch C — same owner email used to backfill singleton Google tokens/commitments
# After 0019: npm run calendar:backfill-owner && npm run calendar:enforce-ownership-not-null

# Optional: require this token on POST /v1/device/register in production
# REGISTER_TOKEN=

# Workers — in-process job queue (plan.generate_day, preparation.run)
WORKER_ENABLED=false

# AI / Search / Maps providers (optional — fake providers used when unset or USE_FAKE_PROVIDERS=true)
# GEMINI_API_KEY=
# LLM_PROVIDER=auto          # auto | fake | gemini | deepseek
# Production Goal Structuring (Railway/backend ONLY — never Vercel NEXT_PUBLIC_*):
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=          # platform.deepseek.com — backend secret only
# DEEPSEEK_MODEL=deepseek-v4-pro
#   Do NOT use legacy deepseek-chat / deepseek-reasoner as current defaults.
#   Tip: USE_FAKE_PROVIDERS=true + LLM_PROVIDER=deepseek uses live DeepSeek
#   while maps/search/calendar stay fake.
# SEARCH_API_KEY=
# GOOGLE_PLACES_API_KEY=
# MAPS_API_KEY=
# FCM_SERVER_KEY=   # Legacy FCM server key for push (optional; no-op without it)
NOTIFY_MAX_PER_DAY=8
# PROACTIVE_SCAN_INTERVAL_MS=2700000  # 45 min when WORKER_ENABLED=true
# CALENDAR_PULL_INTERVAL_MS=900000    # 15 min when WORKER_ENABLED=true
USE_FAKE_PROVIDERS=true

# Phase 09 — Google Calendar OAuth (optional; fake connect when USE_FAKE_PROVIDERS)
# INTEGRATION_ENCRYPTION_KEY=  # defaults to DEVICE_AUTH_PEPPER when unset
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://YOUR-service.up.railway.app/v1/integrations/google/oauth-callback
# PLANNER_WEB_RETURN_URL=https://personal-planner-web-ivory.vercel.app
#   Required in production. Post-OAuth redirect origin (Vercel). Never *.chatgpt.site.
# GOOGLE_COS_CALENDAR_ID=   # write destination; auto-finds/creates "Personal Planner" if unset
# GOOGLE_READ_CALENDAR_IDS= # optional extra EXTERNAL source calendar IDs (comma-separated)
# Strongly recommend GOOGLE_COS_CALENDAR_ID so writes stay on one calendar.

# Docker Compose alternative (if using docker compose up):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/secretary
